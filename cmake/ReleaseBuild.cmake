# SPDX-License-Identifier: MIT
# Initial cache shared by the release driver on every supported host.
set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration")
set(BUILD_TESTING OFF CACHE BOOL "Build component tests")
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Retain production commands")
foreach(_provider IN ITEMS CORE POWERPC ARM UI)
  if(_provider STREQUAL CORE)
    set(_name gc-wii-core)
  elseif(_provider STREQUAL POWERPC)
    set(_name powerpc-recomp-core)
  elseif(_provider STREQUAL ARM)
    set(_name arm-recomp-core)
  else()
    set(_name recomp-ui)
  endif()
  if(EXISTS "${WIILLR_RELEASE_INPUTS}/deps/${_name}/CMakeLists.txt")
    set(WIILLR_${_provider}_SOURCE_DIR "${WIILLR_RELEASE_INPUTS}/deps/${_name}" CACHE PATH "Pinned source provider")
  endif()
endforeach()
set(GCN_VULKAN OFF CACHE BOOL "Build reference Vulkan renderer")
set(GCN_COST_RING ON CACHE BOOL "Qualified consumer cost-ring profile")
set(WIILLR_NATIVE_CHAIN OFF CACHE BOOL "Host native chaining")
set(WIILLR_FP_GUARD_SCOPE OFF CACHE BOOL "Experimental FP scopes")
if(WIILLR_RELEASE_PRODUCT STREQUAL "wiillr")
  set(WIILLR_IOS none CACHE STRING "Developer IOS boundary")
  set(WIILLR_GX none CACHE STRING "Developer GX boundary")
  set(WIILLR_DSP interpreter-development CACHE STRING "Developer DSP boundary")
else()
  set(WIILLR_IOS native-development CACHE STRING "Qualified IOS provider")
  set(WIILLR_GX native-development CACHE STRING "Qualified GX provider")
  set(WIILLR_DSP hle CACHE STRING "Qualified DSP provider")
  set(WIILLR_DSP_DONOR_SOURCE "${WIILLR_RELEASE_INPUTS}/deps/recompcore" CACHE PATH "Pinned DSP source")
  set(WIILLR_DSP_HOST_SOURCE "${WIILLR_RELEASE_INPUTS}/deps/bluewake" CACHE PATH "Pinned DSP adapter")
  set(WIILLR_PPC_GENERATED_DIR "${WIILLR_RELEASE_INPUTS}/catalog/generated" CACHE PATH "Verified original-code catalog")
  set(WIILLR_SCHED deadline CACHE STRING "Qualified timing provider")
  set(WIILLR_IDLE_SKIP ON CACHE BOOL "Qualified idle admission")
  set(WIILLR_NATIVE_CHAIN_CATALOG ON CACHE BOOL "Qualified catalog ABI")
  set(WIILLR_NATIVE_OUTPUT ON CACHE BOOL "Guarded Windows output with portable eager fallback")
  set(WIILLR_LAUNCHER ON CACHE BOOL "Product launcher")
  set(WIILLR_MENU_PICTURES declared-slice CACHE STRING "Qualified Menu material provider")
  set(WIILLR_MENU_TEXT strict CACHE STRING "Qualified Menu text provider")
  set(WIILLR_MENU_FRAME native CACHE STRING "Qualified Menu frame provider")
  set(WIILLR_MENU_TRANSFORM ON CACHE BOOL "Qualified Menu transforms")
  set(WIILLR_MM9_RENDERER declared-slice CACHE STRING "Qualified MM9 renderer")
  set(WIILLR_MM9_FRAME native CACHE STRING "Qualified MM9 frame provider")
  set(WIILLR_MM9_DLC ON CACHE BOOL "Installed original DLC provider")
  set(WIILLR_MMIO table CACHE STRING "Qualified MMIO dispatch")
  set(WIILLR_PACING field CACHE STRING "Normal host pacing")
endif()
